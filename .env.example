# Leave STRIPE_SECRET_KEY empty to run in demo mode (fake checkout, nothing charged).
# Use a test key (sk_test_...) first, then a live key (sk_live_...) to take real money.
STRIPE_SECRET_KEY=

# Public URL Stripe sends buyers back to after paying (e.g. https://aprieta.app).
# Defaults to whatever URL the request came in on.
APRIETA_PUBLIC_URL=

# Prices in cents.
APRIETA_PRICE_SINGLE_CENTS=99
APRIETA_PRICE_PASS_CENTS=299
APRIETA_PASS_HOURS=24
APRIETA_CURRENCY=usd
# "Too late?" add-on: nearest shops selling underwear.
APRIETA_PRICE_BOXERS_CENTS=99
